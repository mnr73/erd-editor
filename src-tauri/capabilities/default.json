{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: own commands, events, the open/save file dialogs, opening this project's own links in the browser, and the self-updater. Nothing else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/mnr73/erd-editor"
        },
        {
          "url": "https://github.com/mnr73/erd-editor/**"
        },
        {
          "url": "https://mnr73.github.io/erd-editor/**"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
